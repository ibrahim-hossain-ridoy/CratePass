# App URL (used for public /p/[slug] links embedded in generated QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secret! NEVER expose or import in Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic PDF Extraction (optional locally: falls back to deterministic mock extractor when blank)
ANTHROPIC_API_KEY=
# Default extraction model; set to "claude-sonnet-5-5" for higher accuracy on complex datasheets
ANTHROPIC_MODEL=claude-haiku-5-5

# Billing Feature Flag & Paddle Sandbox Adapter (M6)
BILLING_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
